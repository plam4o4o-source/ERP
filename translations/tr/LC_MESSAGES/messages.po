msgstr ""
"Uzaktan erişim bileşeni beklenmedik şekilde durdu (internet bağlantısını "
"kontrol edin)."

#: remote_tunnel.py:473
#, python-format
msgid "Неуспешно изтегляне на компонента за отдалечен достъп: %(reason)s"
msgstr "Uzaktan erişim bileşeni indirilemedi: %(reason)s"

#: remote_tunnel.py:501
#, python-format
msgid "Неуспешно стартиране на компонента за отдалечен достъп: %(reason)s"
msgstr "Uzaktan erişim bileşeni başlatılamadı: %(reason)s"

#: routes_admin.py:48
msgid "Адресът не изглежда валиден — не трябва да съдържа интервали."
msgstr "Adres geçerli görünmüyor — boşluk içermemelidir."

#: routes_admin.py:52
msgid "Адресът не изглежда валиден."
msgstr "Adres geçerli görünmüyor."

#: routes_admin.py:54 routes_admin.py:282
msgid "Адресът трябва да започва с http:// или https://."
msgstr "Adres http:// veya https:// ile başlamalıdır."

#: routes_admin.py:59
msgid "Адресът трябва да съдържа домейн (напр. https://firma.example.com)."
msgstr "Adres bir alan adı içermelidir (örn. https://firma.example.com)."

#: routes_admin.py:63
msgid "Адресът не трябва да съдържа потребител или парола (част с „@“)."
msgstr "Adres kullanıcı adı veya parola içermemelidir (“@” içeren kısım)."

#: routes_admin.py:72
msgid "Портът в адреса трябва да е число между 1 и 65535."
msgstr "Adresteki port 1 ile 65535 arasında bir sayı olmalıdır."

#: routes_admin.py:76
msgid "Въведете само адреса на сайта, без път или параметри след домейна."
msgstr ""
"Alan adından sonra yol veya parametre olmadan yalnızca site adresini "
"girin."

#: routes_admin.py:78
msgid "Домейнът в адреса не изглежда валиден."
msgstr "Adresteki alan adı geçerli görünmüyor."

#: routes_admin.py:116
msgid ""
"Въведете пълен път до папката (напр. D:\\Архив или "
"\\\\СЪРВЪР\\споделена\\архив), не относителен."
msgstr ""
"Klasörün tam yolunu girin (ör. D:\\Arsiv veya "
"\\\\SUNUCU\\paylasim\\arsiv), göreli yol değil."

#: routes_admin.py:119
#, python-format
msgid "Пътят „%(path)s“ сочи към файл, а не към папка."
msgstr "“%(path)s” yolu bir klasörü değil, bir dosyayı gösteriyor."

#: routes_admin.py:124
#, python-format
msgid "Папката „%(path)s“ не съществува и не може да бъде създадена (%(reason)s)."
msgstr "“%(path)s” klasörü yok ve oluşturulamıyor (%(reason)s)."

#: routes_admin.py:133
#, python-format
msgid ""
"Няма право на запис в папката „%(path)s“ (%(reason)s) — изберете друга "
"папка."
msgstr "“%(path)s” klasörüne yazma izni yok (%(reason)s) — başka bir klasör seçin."

#: routes_admin.py:224
msgid "Невалиден мрежов порт — въведете число между 1 и 65535."
msgstr "Geçersiz ağ portu — 1 ile 65535 arasında bir sayı girin."

#: routes_admin.py:244
msgid ""
"Мрежовите настройки са запазени. Рестартирайте програмата, за да влязат в"
" сила."
msgstr ""
"Ağ ayarları kaydedildi. Değişikliklerin geçerli olması için programı "
"yeniden başlatın."

#: routes_admin.py:255
msgid "Изгледът на входния екран е запазен."
msgstr "Giriş ekranı görünümü kaydedildi."

#: routes_admin.py:273
msgid "Настройките за локален/мрежов архив са запазени."
msgstr "Yerel/ağ yedekleme ayarları kaydedildi."

#: routes_admin.py:307
msgid ""
"Постоянният публичен адрес е запазен. Новоотпечатаните QR кодове ще го "
"ползват."
msgstr "Kalıcı genel adres kaydedildi. Yeni basılan QR kodları bunu kullanacak."

#: routes_admin.py:309
msgid ""
"Постоянният публичен адрес е изчистен — QR кодовете отново ще ползват "
"локалния адрес."
msgstr ""
"Kalıcı genel adres temizlendi — QR kodları yeniden yerel adresi "
"kullanacak."

#: routes_admin.py:327
msgid "Настройките за клиентски папки са запазени."
msgstr "Müşteri klasörü ayarları kaydedildi."

#: routes_admin.py:340
#, python-format
msgid "Резервно копие е записано: %s"
msgstr "Yedek kaydedildi: %s"

#: routes_admin.py:344
#, python-format
msgid "Архивирането е неуспешно: %s"
msgstr "Yedekleme başarısız oldu: %s"

#: routes_admin.py:358
#, python-format
msgid "Възстановяването не е насрочено: %s"
msgstr "Geri yükleme planlanmadı: %s"

#: routes_admin.py:361
#, python-format
msgid ""
"Възстановяването от %(name)s е насрочено. Затворете програмата на ВСИЧКИ "
"компютри и я стартирайте отново — архивът ще бъде възстановен при "
"стартирането, преди някой да отвори базата. Текущата база ще бъде "
"запазена в папка pre_restore_… до нея."
msgstr ""
"%(name)s yedeğinden geri yükleme planlandı. Programı TÜM bilgisayarlarda "
"kapatıp yeniden başlatın — yedek, kimse veritabanını açmadan önce "
"başlangıçta geri yüklenecek. Mevcut veritabanı yanındaki pre_restore_… "
"klasöründe saklanacak."

#: routes_admin.py:374
msgid "Насроченото възстановяване е отменено."
msgstr "Planlanan geri yükleme iptal edildi."

#: routes_admin.py:393
#, python-format
msgid ""
"Базата е възстановена от архива %(name)s. Предишната база е запазена в "
"папка %(aside)s."
msgstr ""
"Veritabanı %(name)s yedeğinden geri yüklendi. Önceki veritabanı %(aside)s"
" klasöründe saklandı."

#: routes_admin.py:397
#, python-format
msgid "Прикачените файлове и логото от архива НЕ бяха възстановени: %s"
msgstr "Yedekteki ekler ve logo geri YÜKLENMEDİ: %s"

#: routes_admin.py:404
#, python-format
msgid ""
"Възстановяването от архива %(name)s НЕ е извършено — текущата база е "
"непроменена. Причина: %(reason)s"
msgstr ""
"%(name)s yedeğinden geri yükleme YAPILMADI — mevcut veritabanı değişmedi."
" Neden: %(reason)s"

#: routes_admin.py:427
msgid ""
"Стартира се отдалечен достъп… изчакайте няколко секунди, статусът по-долу"
" ще се обнови автоматично."
msgstr ""
"Uzaktan erişim başlatılıyor… lütfen birkaç saniye bekleyin, aşağıdaki "
"durum otomatik olarak güncellenecektir."

#: routes_admin.py:435
msgid "Отдалеченият достъп е спрян."
msgstr "Uzaktan erişim durduruldu."

#: routes_admin.py:460
msgid "Потребителско име и парола са задължителни."
msgstr "Kullanıcı adı ve şifre zorunludur."

#: routes_admin.py:465
#, python-format
msgid "Потребителското име трябва да е най-много %d символа."
msgstr "Kullanıcı adı en fazla %d karakter olmalıdır."

#: routes_admin.py:487
#, python-format
msgid "Вече има служител с потребителско име „%s“."
msgstr "\"%s\" kullanıcı adına sahip bir çalışan zaten mevcut."

#: routes_admin.py:502
#, python-format
msgid "Служителят „%s“ е добавен. Ще трябва да смени паролата при първия вход."
msgstr "\"%s\" çalışanı eklendi. İlk girişte şifresini değiştirmesi gerekecek."

#: routes_admin.py:510
