#: appcore.py:253
msgid "Файлът е твърде голям (максимум 25 MB). Изберете по-малък файл."
msgstr "Dosya çok büyük (maksimum 25 MB). Lütfen daha küçük bir dosya seçin."

#: appcore.py:335
msgid "Първо задайте нова парола, преди да продължите."
msgstr "Devam etmeden önce lütfen yeni bir şifre belirleyin."

#: routes_admin.py:66
msgid "Мрежовите настройки са запазени. Рестартирайте програмата, за да влязат в сила."
msgstr "Ağ ayarları kaydedildi. Değişikliklerin geçerli olması için programı yeniden başlatın."

#: routes_admin.py:74
msgid "Настройките за локален/мрежов архив са запазени."
msgstr "Yerel/ağ yedekleme ayarları kaydedildi."

#: routes_admin.py:89
msgid "Настройките за GitHub синхронизация са запазени."
msgstr "GitHub senkronizasyon ayarları kaydedildi."

#: routes_admin.py:101
#, python-format
msgid "Резервно копие е записано: %s"
msgstr "Yedek kaydedildi: %s"

#: routes_admin.py:103
#, python-format
msgid "Архивирането е неуспешно: %s"
msgstr "Yedekleme başarısız oldu: %s"

#: routes_admin.py:115
msgid "Качването в GitHub стартира във фонов режим — статусът в „Настройки“ ще покаже резултата (презаредете страницата след малко)."
msgstr "GitHub'a yükleme arka planda başlatıldı — sonucu \"Ayarlar\" bölümündeki durum gösterecektir (bir süre sonra sayfayı yeniden yükleyin)."

#: routes_admin.py:133
msgid "Базата данни е изтеглена от GitHub. Рестартирайте програмата, за да заредите новите данни."
msgstr "Veritabanı GitHub'dan indirildi. Yeni verileri yüklemek için programı yeniden başlatın."

#: routes_admin.py:136
#, python-format
msgid "Изтеглянето от GitHub е неуспешно: %s"
msgstr "GitHub'dan indirme başarısız oldu: %s"

#: routes_admin.py:146
msgid "Стартира се отдалечен достъп… изчакайте няколко секунди, статусът по-долу ще се обнови автоматично."
msgstr "Uzaktan erişim başlatılıyor… lütfen birkaç saniye bekleyin, aşağıdaki durum otomatik olarak güncellenecektir."

#: routes_admin.py:154
msgid "Отдалеченият достъп е спрян."
msgstr "Uzaktan erişim durduruldu."

#: routes_admin.py:180
msgid "Потребителско име и парола са задължителни."
msgstr "Kullanıcı adı ve şifre zorunludur."

#: routes_admin.py:183 routes_admin.py:224
#, python-format
msgid "Паролата трябва да е поне %d символа."
msgstr "Şifre en az %d karakter olmalıdır."

#: routes_admin.py:188
#, python-format
msgid "Вече има служител с потребителско име „%s“."
msgstr "\"%s\" kullanıcı adına sahip bir çalışan zaten mevcut."

#: routes_admin.py:200
#, python-format
msgid "Служителят „%s“ е добавен. Ще трябва да смени паролата при първия вход."
msgstr "\"%s\" çalışanı eklendi. İlk girişte şifresini değiştirmesi gerekecek."

#: routes_admin.py:208
msgid "Не можете да деактивирате собствения си акаунт."
msgstr "Kendi hesabınızı devre dışı bırakamazsınız."

#: routes_admin.py:221
msgid "Въведете нова парола."
msgstr "Yeni bir şifre girin."

#: routes_admin.py:234
msgid "Паролата е сменена. Служителят ще трябва да я смени при следващия си вход."
msgstr "Şifre değiştirildi. Çalışan bir sonraki girişte şifresini tekrar değiştirmek zorunda kalacak."

#: routes_admin.py:241
msgid "Не можете да изтриете собствения си акаунт."
msgstr "Kendi hesabınızı silemezsiniz."

#: routes_admin.py:248
msgid "Служителят е изтрит."
msgstr "Çalışan silindi."

#: routes_admin.py:260 routes_admin.py:278
#, python-format
msgid "Проверката за обновяване е неуспешна: %s"
msgstr "Güncelleme denetimi başarısız oldu: %s"

#: routes_admin.py:266
#, python-format
msgid "Налична е нова версия %s (текущата е %s)."
msgstr "Yeni bir %s sürümü mevcut (mevcut sürüm %s)."

#: routes_admin.py:268
#, python-format
msgid "Използвате най-новата версия (%s)."
msgstr "En son sürümü kullanıyorsunuz (%s)."

#: routes_admin.py:281
#, python-format
msgid "Вече използвате най-новата версия (%s)."
msgstr "Zaten en son sürümü kullanıyorsunuz (%s)."

#: routes_admin.py:286
#, python-format
msgid "Обновяването е неуспешно: %s"
msgstr "Güncelleme başarısız oldu: %s"

#: routes_auth.py:80
msgid "Излязохте от системата."
msgstr "Sistemden çıkış yaptınız."

#: routes_auth.py:94
msgid "Текущата парола е грешна."
msgstr "Mevcut şifre yanlış."

#: routes_auth.py:96
#, python-format
msgid "Новата парола трябва да е поне %d символа."
msgstr "Yeni şifre en az %d karakter olmalıdır."

#: routes_auth.py:98
msgid "Двете нови пароли не съвпадат."
msgstr "Girilen yeni şifreler eşleşmiyor."

#: routes_auth.py:106
msgid "Паролата е сменена успешно."
msgstr "Şifre başarıyla değiştirildi."

#: routes_clients.py:49
msgid "Името на фирмата е задължително."
msgstr "Firma adı zorunludur."

#: routes_clients.py:73
msgid "Клиентът е запазен в адресната книга."
msgstr "Müşteri adres defterine kaydedildi."

#: routes_clients.py:87
msgid "Клиентът е изтрит от адресната книга."
msgstr "Müşteri adres defterinden silindi."

