msgstr "%s No'lu belge güncellendi."

#: routes_documents.py:282
msgid "Документът е изтрит."
msgstr "Belge silindi."

#: routes_pallet_extra.py:101 routes_pallet_extra.py:252
msgid "Моля, изберете Excel файл (.xlsx)."
msgstr "Lütfen bir Excel dosyası (.xlsx) seçin."

#: routes_pallet_extra.py:107 routes_pallet_extra.py:258
msgid "Файлът не може да бъде прочетен. Уверете се, че е валиден .xlsx файл."
msgstr "Dosya okunamadı. Geçerli bir .xlsx dosyası olduğundan emin olun."

#: routes_pallet_extra.py:123
msgid "Във файла не бяха намерени редове с данни."
msgstr "Dosyada veri satırı bulunamadı."

#: routes_pallet_extra.py:130
#, python-format
msgid "Заредени са %d реда от „%s“. Прегледайте и издайте картата."
msgstr "%d satır \"%s\" dosyasından yüklendi. İnceleyin ve kartı düzenleyin."

#: routes_pallet_extra.py:263
msgid "Файлът не съдържа разпознаваеми колони (Order No, Pos, Reference, Open Qty) или редове за импорт."
msgstr "Dosya, tanınabilir sütunlar (Order No, Pos, Reference, Open Qty) veya içe aktarılacak satırlar içermiyor."

#: routes_pallet_extra.py:272
#, python-format
msgid "Открити са %d палетни карти (%d реда общо) от „%s“. Прегледайте и издайте."
msgstr "%d palet kartı (toplam %d satır) \"%s\" içinde bulundu. İnceleyin ve düzenleyin."

#: routes_pallet_extra.py:322
msgid "Няма палетни карти за преглед (всички редове са празни)."
msgstr "İncelenecek palet kartı yok (tüm satırlar boş)."

#: routes_pallet_extra.py:332
msgid "Прегледът е изтекъл или вече е използван — заредете файла отново."
msgstr "Önizlemenin süresi doldu veya zaten kullanıldı — lütfen dosyayı yeniden yükleyin."

#: routes_pallet_extra.py:345
msgid "Няма палетни карти за издаване (всички редове са празни)."
msgstr "Düzenlenecek palet kartı yok (tüm satırlar boş)."

#: routes_pallet_extra.py:355
#, python-format
msgid "Издадени и запазени %d палетни карти: %s"
msgstr "%d palet kartı düzenlendi ve kaydedildi: %s"

