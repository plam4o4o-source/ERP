msgstr "Waybill (domestic carriage)"

#: db.py:148
msgid "Декларация за стоки с двойна употреба"
msgstr "Dual-use goods declaration"

#: db.py:149
msgid "Декларация за износ (Италия)"
msgstr "Export declaration (Italy)"

#: db.py:156 templates/base.html:79
msgid "Фактура за Бразилия"
msgstr "Invoice for Brazil"

#: db.py:157 templates/base.html:80
msgid "Фактура за Норвегия"
msgstr "Invoice for Norway"

#: db.py:163 templates/base.html:81
msgid "Фактура за Дубай"
msgstr "Invoice for Dubai"

#: db.py:1504
msgid "Светла (по подразбиране)"
msgstr "Light (default)"

#: db.py:1505
msgid "Тъмна"
msgstr "Dark"

#: db.py:1506
msgid "Синя / корпоративна"
msgstr "Blue / corporate"

#: db.py:1507
msgid "Зелена"
msgstr "Green"

#: db.py:1508
msgid "Висок контраст"
msgstr "High contrast"

#: db.py:1509
msgid "Кафява / топла"
msgstr "Sepia / warm"

#: routes_admin.py:43
msgid "Адресът не изглежда валиден — не трябва да съдържа интервали."
msgstr "The address does not look valid — it must not contain spaces."

#: routes_admin.py:47
msgid "Адресът не изглежда валиден."
msgstr "The address does not look valid."

#: routes_admin.py:49
msgid "Адресът трябва да започва с http:// или https://."
msgstr "The address must start with http:// or https://."

#: routes_admin.py:54
msgid "Адресът трябва да съдържа домейн (напр. https://firma.example.com)."
msgstr "The address must contain a domain (e.g. https://firma.example.com)."

#: routes_admin.py:58
msgid "Въведете само адреса на сайта, без път или параметри след домейна."
msgstr ""
"Enter only the site address, without a path or parameters after the "
"domain."

#: routes_admin.py:60
msgid "Домейнът в адреса не изглежда валиден."
msgstr "The domain in the address does not look valid."

#: routes_admin.py:112
msgid "Невалиден мрежов порт — въведете число между 1 и 65535."
msgstr "Invalid network port — enter a number between 1 and 65535."

#: routes_admin.py:132
msgid ""
"Мрежовите настройки са запазени. Рестартирайте програмата, за да влязат в"
" сила."
msgstr ""
"The network settings have been saved. Restart the program for the changes"
" to take effect."

#: routes_admin.py:143
msgid "Изгледът на входния екран е запазен."
msgstr "The login screen appearance has been saved."

#: routes_admin.py:150
msgid "Настройките за локален/мрежов архив са запазени."
msgstr "Local/network backup settings have been saved."

#: routes_admin.py:177
msgid ""
"Постоянният публичен адрес е запазен. Новоотпечатаните QR кодове ще го "
"ползват."
msgstr ""
"The permanent public address has been saved. Newly printed QR codes will "
"use it."

#: routes_admin.py:179
msgid ""
"Постоянният публичен адрес е изчистен — QR кодовете отново ще ползват "
"локалния адрес."
msgstr ""
"The permanent public address has been cleared — QR codes will use the "
"local address again."

#: routes_admin.py:187
msgid "Настройките за клиентски папки са запазени."
msgstr "The customer folder settings have been saved."

#: routes_admin.py:200
#, python-format
msgid "Резервно копие е записано: %s"
msgstr "Backup saved: %s"

#: routes_admin.py:202
#, python-format
msgid "Архивирането е неуспешно: %s"
msgstr "Backup failed: %s"

#: routes_admin.py:223
msgid ""
"Стартира се отдалечен достъп… изчакайте няколко секунди, статусът по-долу"
" ще се обнови автоматично."
msgstr ""
"Starting remote access… please wait a few seconds, the status below will "
"update automatically."

#: routes_admin.py:231
msgid "Отдалеченият достъп е спрян."
msgstr "Remote access has been stopped."

#: routes_admin.py:256
msgid "Потребителско име и парола са задължителни."
msgstr "Username and password are required."

#: routes_admin.py:259 routes_admin.py:376
#, python-format
msgid "Паролата трябва да е поне %d символа."
msgstr "The password must be at least %d characters."

#: routes_admin.py:264
#, python-format
msgid "Вече има служител с потребителско име „%s“."
msgstr "An employee with the username \"%s\" already exists."

#: routes_admin.py:276
#, python-format
msgid "Служителят „%s“ е добавен. Ще трябва да смени паролата при първия вход."
msgstr ""
"Employee \"%s\" has been added. They will need to change their password "
"on first login."

#: routes_admin.py:284
msgid ""
"Това е последният активен администратор — ако го деактивирате или "
"изтриете, никой няма да може да влезе в администрацията (управление на "
"служители, системни настройки, архивиране, обновяване). Първо направете "
"друг потребител администратор."
msgstr ""
"This is the last active administrator — deactivating or deleting them "
"would leave nobody able to reach the administration area (staff "
"management, system settings, backups, updates). Make another user an "
"administrator first."

#: routes_admin.py:321
msgid "Не можете да деактивирате собствения си акаунт."
msgstr "You cannot deactivate your own account."

#: routes_admin.py:354
msgid ""
"Състоянието на този акаунт е било променено междувременно — страницата е "
"презаредена, проверете и опитайте пак."
msgstr ""
"This account's state changed in the meantime — the page has been "
"reloaded; check it and try again."

#: routes_admin.py:373
msgid "Въведете нова парола."
msgstr "Enter a new password."

#: routes_admin.py:402
msgid "Паролата е сменена. Служителят ще трябва да я смени при следващия си вход."
msgstr ""
"The password has been changed. The employee will need to change it again "
"on their next login."

#: routes_admin.py:409
msgid "Не можете да изтриете собствения си акаунт."
msgstr "You cannot delete your own account."

#: routes_admin.py:440
msgid "Служителят е изтрит."
msgstr "The employee has been deleted."

#: routes_admin.py:458 routes_admin.py:474
#, python-format
msgid "Проверката за обновяване е неуспешна: %s"
msgstr "The update check failed: %s"

#: routes_admin.py:462
#, python-format
msgid "Налична е нова версия %s (текущата е %s)."
msgstr "A new version %s is available (current version is %s)."

#: routes_admin.py:464
#, python-format
msgid "Използвате най-новата версия (%s)."
msgstr "You are using the latest version (%s)."

#: routes_admin.py:477
#, python-format
msgid "Вече използвате най-новата версия (%s)."
msgstr "You are already using the latest version (%s)."

#: routes_admin.py:489
#, python-format
msgid "Обновяването е неуспешно: %s"
msgstr "The update failed: %s"

#: routes_auth.py:273
msgid "Излязохте от системата."
msgstr "You have been logged out."

#: routes_auth.py:297
#, python-format
msgid "Твърде много грешни опити. Опитайте отново след около %d мин."
msgstr "Too many failed attempts. Try again in about %d min."

#: routes_auth.py:305
msgid "Текущата парола е грешна."
msgstr "The current password is incorrect."

#: routes_auth.py:307
#, python-format
msgid "Новата парола трябва да е поне %d символа."
msgstr "The new password must be at least %d characters."

#: routes_auth.py:309
msgid "Двете нови пароли не съвпадат."
msgstr "The two new passwords do not match."

#: routes_auth.py:343
msgid "Паролата е сменена успешно."
msgstr "The password has been changed successfully."

#: routes_clients.py:213
msgid "Името на фирмата е задължително."
msgstr "The company name is required."

#: routes_clients.py:229
#, python-format
msgid ""
"Преименувахте клиента от „%(old)s“ на „%(new)s“ — %(count)s%(plus)s вече "
"издадени документи ще продължат да показват старото име „%(old)s“ "
"(документите пазят името, каквото е било при издаването им, не се "
"променят ретроактивно)."
msgstr ""
"You renamed the customer from „%(old)s“ to „%(new)s“ — %(count)s%(plus)s "
"already issued documents will keep showing the old name „%(old)s“ "
"(documents preserve the name as it was at the time of issue; they are not"
" changed retroactively)."

#: routes_clients.py:261
msgid "Клиентът е запазен в адресната книга."
msgstr "The client has been saved to the address book."

#: routes_clients.py:310
msgid "Клиентът е изтрит от адресната книга."
msgstr "The client has been deleted from the address book."

#: routes_dashboard.py:163
#, python-format
msgid "Няма документ с баркод „%s“."
msgstr "There is no document with barcode „%s“."

#: routes_documents.py:385
#, python-format
msgid "Публичният достъп е подновен до %(until)s."
msgstr "Public access has been renewed until %(until)s."

#: routes_documents.py:411
msgid "Публичният достъп е отнет — QR кодът на бланката вече не отваря документа."
msgstr ""
"Public access has been revoked — the QR code on the form no longer opens "
"the document."

#: routes_documents.py:471
msgid "Моля, изберете файл (снимка или PDF)."
msgstr "Please select a file (photo or PDF)."

#: routes_documents.py:475
msgid "Файлът е прикачен към документа."
msgstr "The file has been attached to the document."

#: routes_documents.py:477
#, python-format
msgid "Файлът не бе приет: %s"
msgstr "The file was not accepted: %s"

#: routes_documents.py:515
msgid "Прикаченият файл е изтрит."
msgstr "The attachment has been deleted."

#: routes_documents.py:517
msgid "Файлът вече не съществува."
msgstr "The file no longer exists."

#: routes_documents.py:542
msgid ""
"Документът е бил редактиран от друг потребител междувременно (докато тази"
" форма е била отворена) — за да не презапишете случайно неговите промени,"
" страницата е презаредена с актуалните данни. Приложете промените си "
"наново."
msgstr ""
"The document was edited by another user in the meantime (while this form "
"was open) — to prevent you from accidentally overwriting their changes, "
"the page has been reloaded with the current data. Please apply your "
"changes again."

#: routes_documents.py:655 routes_documents.py:1704
#, python-format
msgid ""
"Номер %s вече е зает от друг документ от същата година. Въведеното е "
"запазено — променете номера и опитайте пак."
msgstr ""
"Number %s is already taken by another document from the same year. What "
"you entered has been kept — change the number and try again."

#: routes_documents.py:660
#, python-format
msgid "Документ № %s е обновен."
msgstr "Document No. %s has been updated."

#: routes_documents.py:693
msgid ""
"Данните от предварителния преглед вече не са налични (изтекъл линк) — "
"показани са последно запазените стойности на документа."
msgstr ""
"The preview data is no longer available (expired link) — the last saved "
"values of the document are shown instead."

#: routes_documents.py:1307
msgid ""
"Файлът се свали успешно, но копието в клиентската папка НЕ беше записано "
"(недостъпна папка, пълен диск или отказано от системата име). Проверете "
"настройката „Папка за клиентски копия“ в системните настройки."
msgstr ""
"The file was downloaded successfully, but the copy in the client folder "
"was NOT saved (unreachable folder, full disk, or a name refused by the "
"system). Check the “Folder for client copies” setting in the system "
"settings."

#: routes_documents.py:1427
msgid ""
"Точно сега се генерират други PDF файлове. Изчакайте няколко секунди и "
"опитайте пак."
msgstr ""
"Other PDF files are being generated right now. Wait a few seconds and try"
" again."

#: routes_documents.py:1435
msgid ""
"PDF файлът не можа да се генерира за този документ. Опитайте пак — ако "
"продължава, съобщете на администратор."
msgstr ""
"The PDF file could not be generated for this document. Try again — if it "
"persists, notify an administrator."

#: routes_documents.py:1471
msgid "Документът е изтрит."
msgstr "The document has been deleted."

#: routes_documents.py:1541
#, python-format
msgid ""
"Внимание: вече има издаден документ с номер %(number)s през %(year)s г. "
"Проверете дали номерът е верен."
msgstr ""
"Warning: a document with number %(number)s has already been issued in "
"%(year)s. Check whether the number is correct."

#: routes_documents.py:1561
#, python-format
msgid ""
"Внимание: фактурата съдържа редове от %(count)d различни поръчки "
"(%(pos)s). Обичайно една фактура се издава за ЕДНА поръчка — проверете "
"дали останалите не трябва да са на отделни фактури."
msgstr ""
"Warning: the invoice contains lines from %(count)d different orders "
"(%(pos)s). Normally one invoice is issued for ONE order — check whether "
"the others should go on separate invoices."

#: routes_documents.py:1576
#, python-format
msgid ""
"Внимание: ред(ове) №%(rows)s съдържат отрицателно количество/цена/тегло. "
"Такъв ред НЕ участва в сборовете под таблицата, но стойността му се вижда"
" суровa на бланката — проверете дали не е печатна грешка."
msgstr ""
"Warning: line(s) No. %(rows)s contain a negative quantity/price/weight. "
"Such a line is NOT included in the totals below the table, but its value "
"is printed as-is on the form — check whether it is a typing error."

#: routes_documents.py:1585
#, python-format
msgid ""
"Внимание: ред(ове) №%(rows)s съдържат количество/цена/тегло, което не "
"може да бъде разчетено като число (допустими са само цифри с точка или "
"запетая, напр. 1234.56). Такъв ред се ВИЖДА на бланката, но НЕ участва в "
"общата сума — проверете стойностите."
msgstr ""
"Warning: line(s) No. %(rows)s contain a quantity/price/weight that cannot"
" be read as a number (only digits with a dot or comma are allowed, e.g. "
"1234.56). Such a line IS shown on the form, but is NOT included in the "
"total — check the values."

#: routes_documents.py:1602
#, python-format
msgid ""
"Внимание: полето/полетата %(fields)s съдържат отрицателна стойност. Тя се"
" печата суровa на бланката и НЕ участва в сборовете — проверете дали не е"
" печатна грешка."
msgstr "Warning: the field(s) %(fields)s contain a negative value. It is printed as-is on the form and is NOT included in the totals — check whether it is a typo."

#: routes_documents.py:1607
#, python-format
msgid ""
"Внимание: полето/полетата %(fields)s съдържат стойност, която не може да "
"бъде разчетена като число (допустими са само цифри с точка или запетая, "
"напр. 1234.56). Тя се печата буквално на бланката, а в Excel износа влиза"
" като текст, не като число."
msgstr "Warning: the field(s) %(fields)s contain a value that cannot be read as a number (only digits with a dot or comma are allowed, e.g. 1234.56). It is printed literally on the form and goes into the Excel export as text, not as a number."

#: routes_documents.py:1621
#, python-format
msgid ""
"Внимание: „%(label)s“ е въведено %(typed)s, а сборът на редовете дава "
"%(computed)s. Проверете дали не е печатна грешка — на бланката се "
"отпечатва въведената стойност."
msgstr ""
"Warning: „%(label)s“ was entered as %(typed)s, while the sum of the lines"
" gives %(computed)s. Check whether it is a typing error — the entered "
"value is what gets printed on the form."

#: routes_documents.py:1659
msgid ""
"Не е въведен номер на фактурата — документът получи автоматичен вътрешен "
"номер. Ако клиентът очаква Ваш фактурен номер, редактирайте документа и "
"го въведете."
msgstr ""
"No invoice number was entered — the document received an automatic "
"internal number. If the customer expects your invoice number, edit the "
"document and enter it."

#: routes_documents.py:1732
#, python-format
msgid ""
"Документът НЕ можа да бъде записан (%(reason)s). Въведеното е запазено — "
"опитайте отново след няколко секунди."
msgstr "The document could NOT be saved (%(reason)s). What you entered has been kept — try again in a few seconds."

#: routes_documents.py:1786
msgid ""
