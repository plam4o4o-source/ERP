msgstr "Sepia / warm"

#: routes_admin.py:71
msgid "Невалиден мрежов порт — въведете число между 1 и 65535."
msgstr "Invalid network port — enter a number between 1 and 65535."

#: routes_admin.py:82
msgid ""
"Мрежовите настройки са запазени. Рестартирайте програмата, за да влязат в "
"сила."
msgstr ""
"The network settings have been saved. Restart the program for the changes to "
"take effect."

#: routes_admin.py:93
msgid "Изгледът на входния екран е запазен."
msgstr "The login screen appearance has been saved."

#: routes_admin.py:100
msgid "Настройките за локален/мрежов архив са запазени."
msgstr "Local/network backup settings have been saved."

#: routes_admin.py:107
msgid "Настройките за клиентски папки са запазени."
msgstr "The customer folder settings have been saved."

#: routes_admin.py:135
#, python-format
msgid ""
"ВНИМАНИЕ: хранилището %s/%s в GitHub НЕ е частно (public) — базата данни "
"съдържа пароли и данни на всички клиенти. Направете го частно (Settings → "
"Danger Zone → Change visibility) НЕЗАБАВНО."
msgstr ""
"WARNING: the GitHub repository %s/%s is NOT private (it is public) — the "
"database contains passwords and the data of all customers. Make it private "
"(Settings → Danger Zone → Change visibility) IMMEDIATELY."

#: routes_admin.py:142
msgid "Настройките за GitHub синхронизация са запазени."
msgstr "GitHub synchronization settings have been saved."

#: routes_admin.py:152
#, python-format
msgid "Резервно копие е записано: %s"
msgstr "Backup saved: %s"

#: routes_admin.py:154
#, python-format
msgid "Архивирането е неуспешно: %s"
msgstr "Backup failed: %s"

#: routes_admin.py:166
msgid ""
"Качването в GitHub стартира във фонов режим — статусът в „Настройки“ ще "
"покаже резултата (презаредете страницата след малко)."
msgstr ""
"The upload to GitHub has started in the background — the status in "
"\"Settings\" will show the result (reload the page in a moment)."

#: routes_admin.py:197
msgid ""
"Базата данни е изтеглена от GitHub. Рестартирайте програмата, за да заредите "
"новите данни."
msgstr ""
"The database has been downloaded from GitHub. Restart the program to load the"
" new data."

#: routes_admin.py:200
#, python-format
msgid "Изтеглянето от GitHub е неуспешно: %s"
msgstr "Download from GitHub failed: %s"

#: routes_admin.py:216
msgid ""
"Стартира се отдалечен достъп… изчакайте няколко секунди, статусът по-долу ще "
"се обнови автоматично."
msgstr ""
"Starting remote access… please wait a few seconds, the status below will "
"update automatically."

#: routes_admin.py:224
msgid "Отдалеченият достъп е спрян."
msgstr "Remote access has been stopped."

#: routes_admin.py:249
msgid "Потребителско име и парола са задължителни."
msgstr "Username and password are required."

#: routes_admin.py:252 routes_admin.py:291
#, python-format
msgid "Паролата трябва да е поне %d символа."
msgstr "The password must be at least %d characters."

#: routes_admin.py:257
#, python-format
msgid "Вече има служител с потребителско име „%s“."
msgstr "An employee with the username \"%s\" already exists."

#: routes_admin.py:269
#, python-format
msgid "Служителят „%s“ е добавен. Ще трябва да смени паролата при първия вход."
msgstr ""
"Employee \"%s\" has been added. They will need to change their password on "
"first login."

#: routes_admin.py:276
msgid "Не можете да деактивирате собствения си акаунт."
msgstr "You cannot deactivate your own account."

#: routes_admin.py:288
msgid "Въведете нова парола."
msgstr "Enter a new password."

#: routes_admin.py:306
msgid "Паролата е сменена. Служителят ще трябва да я смени при следващия си вход."
msgstr ""
"The password has been changed. The employee will need to change it again on "
"their next login."

#: routes_admin.py:313
msgid "Не можете да изтриете собствения си акаунт."
msgstr "You cannot delete your own account."

#: routes_admin.py:334
msgid "Служителят е изтрит."
msgstr "The employee has been deleted."

#: routes_admin.py:352 routes_admin.py:368
#, python-format
msgid "Проверката за обновяване е неуспешна: %s"
msgstr "The update check failed: %s"

#: routes_admin.py:356
#, python-format
msgid "Налична е нова версия %s (текущата е %s)."
msgstr "A new version %s is available (current version is %s)."

#: routes_admin.py:358
#, python-format
msgid "Използвате най-новата версия (%s)."
msgstr "You are using the latest version (%s)."

#: routes_admin.py:371
#, python-format
msgid "Вече използвате най-новата версия (%s)."
msgstr "You are already using the latest version (%s)."

#: routes_admin.py:376
#, python-format
msgid "Обновяването е неуспешно: %s"
msgstr "The update failed: %s"

#: routes_auth.py:206
msgid "Излязохте от системата."
msgstr "You have been logged out."

#: routes_auth.py:230
#, python-format
msgid "Твърде много грешни опити. Опитайте отново след около %d мин."
msgstr "Too many failed attempts. Try again in about %d min."

#: routes_auth.py:238
msgid "Текущата парола е грешна."
msgstr "The current password is incorrect."

#: routes_auth.py:240
#, python-format
msgid "Новата парола трябва да е поне %d символа."
msgstr "The new password must be at least %d characters."

#: routes_auth.py:242
msgid "Двете нови пароли не съвпадат."
msgstr "The two new passwords do not match."

#: routes_auth.py:262
msgid "Паролата е сменена успешно."
msgstr "The password has been changed successfully."

#: routes_clients.py:213
msgid "Името на фирмата е задължително."
msgstr "The company name is required."

#: routes_clients.py:229
#, python-format
msgid ""
"Преименувахте клиента от „%(old)s“ на „%(new)s“ — %(count)s%(plus)s вече "
"издадени документи ще продължат да показват старото име „%(old)s“ "
"(документите пазят името, каквото е било при издаването им, не се променят "
"ретроактивно)."
msgstr ""
"You renamed the customer from „%(old)s“ to „%(new)s“ — %(count)s%(plus)s "
"already issued documents will keep showing the old name „%(old)s“ (documents "
"preserve the name as it was at the time of issue; they are not changed "
"retroactively)."

#: routes_clients.py:261
msgid "Клиентът е запазен в адресната книга."
msgstr "The client has been saved to the address book."

#: routes_clients.py:286
msgid "Клиентът е изтрит от адресната книга."
msgstr "The client has been deleted from the address book."

#: routes_dashboard.py:163
#, python-format
msgid "Няма документ с баркод „%s“."
msgstr "There is no document with barcode „%s“."

#: routes_documents.py:355
msgid "Моля, изберете файл (снимка или PDF)."
msgstr "Please select a file (photo or PDF)."

#: routes_documents.py:359
msgid "Файлът е прикачен към документа."
msgstr "The file has been attached to the document."

#: routes_documents.py:361
#, python-format
msgid "Файлът не бе приет: %s"
msgstr "The file was not accepted: %s"

#: routes_documents.py:399
msgid "Прикаченият файл е изтрит."
msgstr "The attachment has been deleted."

#: routes_documents.py:401
msgid "Файлът вече не съществува."
msgstr "The file no longer exists."

#: routes_documents.py:426
msgid ""
"Документът е бил редактиран от друг потребител междувременно (докато тази "
"форма е била отворена) — за да не презапишете случайно неговите промени, "
"страницата е презаредена с актуалните данни. Приложете промените си наново."
msgstr ""
"The document was edited by another user in the meantime (while this form was "
"open) — to prevent you from accidentally overwriting their changes, the page "
"has been reloaded with the current data. Please apply your changes again."

#: routes_documents.py:509 routes_documents.py:1326
#, python-format
msgid ""
"Номер %s вече е зает от друг документ (издаден точно междувременно от друг "
"потребител) — въведете различен номер и опитайте отново."
msgstr ""
"Number %s is already taken by another document (issued in the meantime by "
"another user) — enter a different number and try again."

#: routes_documents.py:513
#, python-format
msgid "Документ № %s е обновен."
msgstr "Document No. %s has been updated."

#: routes_documents.py:546
msgid ""
"Данните от предварителния преглед вече не са налични (изтекъл линк) — "
"показани са последно запазените стойности на документа."
msgstr ""
"The preview data is no longer available (expired link) — the last saved "
"values of the document are shown instead."

#: routes_documents.py:1028
msgid ""
"Файлът се свали успешно, но копието в клиентската папка НЕ беше записано "
"(недостъпна папка, пълен диск или отказано от системата име). Проверете "
"настройката „Папка за клиентски копия“ в системните настройки."
msgstr ""
"The file was downloaded successfully, but the copy in the client folder was "
"NOT saved (unreachable folder, full disk, or a name refused by the system). "
"Check the “Folder for client copies” setting in the system settings."

#: routes_documents.py:1128
msgid ""
"PDF файлът не можа да се генерира за този документ. Опитайте пак — ако "
"продължава, съобщете на администратор."
msgstr ""
"The PDF file could not be generated for this document. Try again — if it "
"persists, notify an administrator."

#: routes_documents.py:1164
msgid "Документът е изтрит."
msgstr "The document has been deleted."

#: routes_documents.py:1218
#, python-format
msgid ""
"Внимание: вече има издаден документ с номер %s през тази година. Проверете "
"дали номерът е верен."
msgstr ""
"Warning: a document with number %s has already been issued this year. Check "
"whether the number is correct."

#: routes_documents.py:1237
#, python-format
msgid ""
"Внимание: фактурата съдържа редове от %(count)d различни поръчки (%(pos)s). "
"Обичайно една фактура се издава за ЕДНА поръчка — проверете дали останалите "
"не трябва да са на отделни фактури."
msgstr ""
"Warning: the invoice contains lines from %(count)d different orders "
"(%(pos)s). Normally one invoice is issued for ONE order — check whether the "
"others should go on separate invoices."

#: routes_documents.py:1252
#, python-format
msgid ""
"Внимание: ред(ове) №%(rows)s съдържат отрицателно количество/цена/тегло. "
"Такъв ред НЕ участва в сборовете под таблицата, но стойността му се вижда "
"суровa на бланката — проверете дали не е печатна грешка."
msgstr ""
"Warning: line(s) No. %(rows)s contain a negative quantity/price/weight. Such "
"a line is NOT included in the totals below the table, but its value is "
"printed as-is on the form — check whether it is a typing error."

#: routes_documents.py:1261
#, python-format
msgid ""
"Внимание: ред(ове) №%(rows)s съдържат количество/цена/тегло, което не може да"
" бъде разчетено като число (допустими са само цифри с точка или запетая, "
"напр. 1234.56). Такъв ред се ВИЖДА на бланката, но НЕ участва в общата сума —"
" проверете стойностите."
msgstr ""
"Warning: line(s) No. %(rows)s contain a quantity/price/weight that cannot be "
"read as a number (only digits with a dot or comma are allowed, e.g. 1234.56)."
" Such a line IS shown on the form, but is NOT included in the total — check "
"the values."

#: routes_documents.py:1275
#, python-format
msgid ""
"Внимание: „%(label)s“ е въведено %(typed)s, а сборът на редовете дава "
"%(computed)s. Проверете дали не е печатна грешка — на бланката се отпечатва "
"въведената стойност."
msgstr ""
"Warning: „%(label)s“ was entered as %(typed)s, while the sum of the lines "
"gives %(computed)s. Check whether it is a typing error — the entered value is"
" what gets printed on the form."

#: routes_documents.py:1309
msgid ""
"Не е въведен номер на фактурата — документът получи автоматичен вътрешен "
"номер. Ако клиентът очаква Ваш фактурен номер, редактирайте документа и го "
"въведете."
msgstr ""
"No invoice number was entered — the document received an automatic internal "
"number. If the customer expects your invoice number, edit the document and "
"enter it."

#: routes_invoices.py:73 routes_pallet_extra.py:90
#, python-format
msgid "Заглавният ред трябва да е в първите %d реда на листа."
msgstr "The header row must be within the first %d rows of the sheet."

#: routes_invoices.py:78 routes_pallet_extra.py:96
msgid ""
"Файлът съдържа формули без запазени стойности — отворете го и го запишете от "
"Excel, след което опитайте отново."
msgstr ""
"The file contains formulas without stored values — open it and save it from "
"Excel, then try again."

#: routes_invoices.py:92 routes_pallet_extra.py:118
#, python-format
msgid "Данните са прочетени от лист „%(sheet)s“ (файлът съдържа %(count)d листа)."
msgstr "The data was read from sheet “%(sheet)s” (the file contains %(count)d sheets)."

#: routes_invoices.py:247 routes_pallet_extra.py:174
msgid "Въведете номер или баркод на палетна карта."
msgstr "Enter the number or barcode of a pallet card."

#: routes_invoices.py:266 routes_pallet_extra.py:189
#, python-format
msgid "Намереният документ не е палетна карта (%s)."
msgstr "The document found is not a pallet card (%s)."

#: routes_invoices.py:267 routes_pallet_extra.py:190
#, python-format
msgid "Няма документ с номер/баркод „%s“."
msgstr "There is no document with number/barcode „%s“."

#: routes_invoices.py:273
#, python-format
msgid "Палетна карта № %s няма редове за прехвърляне."
msgstr "Pallet card No. %s has no lines to transfer."

#: routes_invoices.py:402 routes_materials.py:74 routes_pallet_extra.py:324
#, python-format
msgid ""
"Заглавният ред е открит на ред %d от файла (пропуснати са %d реда над него) —"
" проверете дали разпознатите данни са правилни."
msgstr ""
"The header row was found on row %d of the file (%d rows above it were "
"skipped) — check whether the recognised data is correct."

#: routes_invoices.py:410 routes_materials.py:79 routes_pallet_extra.py:333
#, python-format
msgid ""
"Файлът съдържа повече от %d реда данни — заредени са само първите %d, "
"останалите са пропуснати."
msgstr ""
"The file contains more than %d data rows — only the first %d were loaded, the"
" rest were skipped."

#: routes_invoices.py:458
msgid "Изберете Excel файл (.xlsx)."
msgstr "Select an Excel file (.xlsx)."

#: routes_invoices.py:467 routes_materials.py:59 routes_pallet_extra.py:438
msgid "Файлът не може да бъде прочетен. Уверете се, че е валиден .xlsx файл."
msgstr "The file could not be read. Make sure it is a valid .xlsx file."

#: routes_invoices.py:471 routes_materials.py:82
msgid ""
"Файлът съдържа обединени клетки — стойности извън първата клетка на обединен "
"диапазон може да липсват."
msgstr ""
"The file contains merged cells — values outside the first cell of a merged "
"range may be missing."

#: routes_invoices.py:480 routes_pallet_extra.py:455
msgid ""
"Файлът не съдържа разпознаваеми колони (Order No, Pos, Reference, Reference "
"Desc, Open Qty) или редове за импорт."
msgstr ""
"The file does not contain recognisable columns (Order No, Pos, Reference, "
"Reference Desc, Open Qty) or any rows to import."

#: routes_invoices.py:612
msgid "Въведете име на записа."
msgstr "Enter a name for the entry."

#: routes_invoices.py:615
msgid "Записът в адресната книга за фактури е запазен."
msgstr "The entry in the invoice address book has been saved."

#: routes_invoices.py:632
msgid "Записът е изтрит от адресната книга за фактури."
msgstr "The entry has been deleted from the invoice address book."

#: routes_materials.py:44
msgid "Моля, изберете Excel файл (.xlsx) със справочника."
msgstr "Please select an Excel file (.xlsx) with the catalogue."

#: routes_materials.py:63
msgid ""
"Файлът не съдържа разпознаваеми колони. Нужни са колона с код на материала "
"(напр. „ABB part ID“) и поне една от „Description“ / „Net weight [KG/pc]“."
msgstr ""
"The file does not contain recognisable columns. A material code column (e.g. "
"„ABB part ID“) and at least one of „Description“ / „Net weight [KG/pc]“ are "
"required."

#: routes_materials.py:88
#, python-format
msgid ""
"%(count)d реда с неразпознато тегло (напр. „nan“, „N/A“, „—“ или отрицателна "
"стойност) — за тях теглото остава празно и се въвежда ръчно."
msgstr ""
