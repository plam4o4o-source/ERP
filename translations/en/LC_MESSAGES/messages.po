msgstr "Invalid date."

#: routes_parties.py:536
msgid "Партньорът не е намерен."
msgstr "The partner was not found."

#: routes_parties.py:549
msgid "Въведете име на партньора."
msgstr "Enter the partner's name."

#: routes_parties.py:571
#, python-format
msgid "Корекцията е записана в палетната сметка на „%s“."
msgstr "The correction was recorded in the pallet account of “%s”."

#: routes_parties.py:582
msgid "Движение от ЧМР не се трие оттук — редактирайте палетите в самото ЧМР."
msgstr ""
