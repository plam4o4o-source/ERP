msgstr "The pallet card does not store a net weight — enter it manually."

#: routes_pallet_extra.py:316
#, python-format
msgid ""
"Няма палетна карта с номер/баркод „%(code)s“. Пълният номер е във вида "
"0001/%(year)s, а баркодът — PAL-…"
msgstr ""
"No pallet card with number/barcode “%(code)s”. The full number looks like"
