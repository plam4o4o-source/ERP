#, python-format
msgid ""
"Няма право на запис в папката „%(path)s“ (%(reason)s) — изберете друга "
"папка."
msgstr ""
"No write permission for the folder “%(path)s” (%(reason)s) — choose "
"another folder."

#: routes_admin.py:233
msgid "Невалиден мрежов порт — въведете число между 1 и 65535."
msgstr "Invalid network port — enter a number between 1 and 65535."

#: routes_admin.py:253
msgid ""
"Мрежовите настройки са запазени. Рестартирайте програмата, за да влязат в"
" сила."
msgstr ""
"The network settings have been saved. Restart the program for the changes"
" to take effect."

#: routes_admin.py:264
msgid "Изгледът на входния екран е запазен."
msgstr "The login screen appearance has been saved."

#: routes_admin.py:282
msgid "Настройките за локален/мрежов архив са запазени."
msgstr "Local/network backup settings have been saved."

#: routes_admin.py:316
msgid ""
"Постоянният публичен адрес е запазен. Новоотпечатаните QR кодове ще го "
"ползват."
msgstr ""
"The permanent public address has been saved. Newly printed QR codes will "
"use it."

#: routes_admin.py:318
msgid ""
"Постоянният публичен адрес е изчистен — QR кодовете отново ще ползват "
"локалния адрес."
msgstr ""
"The permanent public address has been cleared — QR codes will use the "
"local address again."

#: routes_admin.py:336
msgid "Настройките за клиентски папки са запазени."
msgstr "The customer folder settings have been saved."

#: routes_admin.py:349
#, python-format
msgid "Резервно копие е записано: %s"
msgstr "Backup saved: %s"

#: routes_admin.py:353
#, python-format
msgid "Архивирането е неуспешно: %s"
msgstr "Backup failed: %s"

#: routes_admin.py:367
#, python-format
msgid "Възстановяването не е насрочено: %s"
msgstr "The restore was not scheduled: %s"

#: routes_admin.py:370
#, python-format
msgid ""
"Възстановяването от %(name)s е насрочено. Затворете програмата на ВСИЧКИ "
"компютри и я стартирайте отново — архивът ще бъде възстановен при "
"стартирането, преди някой да отвори базата. Текущата база ще бъде "
"запазена в папка pre_restore_… до нея."
msgstr ""
"Restore from %(name)s is scheduled. Close the program on ALL computers "
"and start it again — the backup will be restored at startup, before "
"anyone opens the database. The current database will be kept in a "
"pre_restore_… folder next to it."

#: routes_admin.py:383
msgid "Насроченото възстановяване е отменено."
msgstr "The scheduled restore was cancelled."

#: routes_admin.py:402
#, python-format
msgid ""
"Базата е възстановена от архива %(name)s. Предишната база е запазена в "
"папка %(aside)s."
msgstr ""
"The database was restored from the backup %(name)s. The previous database"
" was kept in the folder %(aside)s."

#: routes_admin.py:406
#, python-format
msgid "Прикачените файлове и логото от архива НЕ бяха възстановени: %s"
msgstr "The attachments and logo from the backup were NOT restored: %s"

#: routes_admin.py:413
#, python-format
msgid ""
"Възстановяването от архива %(name)s НЕ е извършено — текущата база е "
"непроменена. Причина: %(reason)s"
msgstr ""
"The restore from the backup %(name)s was NOT performed — the current "
"database is unchanged. Reason: %(reason)s"

#: routes_admin.py:428
msgid "старата папка е споделена в мрежата"
msgstr "the old folder is shared on the network"

#: routes_admin.py:429
msgid "старата папка е на мрежов диск"
msgstr "the old folder is on a network drive"

#: routes_admin.py:430
msgid "не може да се провери дали старата папка е споделена в мрежата"
msgstr "it cannot be checked whether the old folder is shared on the network"

#: routes_admin.py:431
msgid "старата версия на програмата още работеше"
msgstr "the old version of the program was still running"

#: routes_admin.py:432
msgid "файл в старата папка беше зает"
msgstr "a file in the old folder was in use"

#: routes_admin.py:433
msgid "пътят до базата в настройките сочи изрично към старата папка"
msgstr "the database path in the settings explicitly points to the old folder"

#: routes_admin.py:434
msgid "папката за архив е в старата папка"
msgstr "the backup folder is inside the old folder"

#: routes_admin.py:435
msgid "насроченото възстановяване е от архив в старата папка"
msgstr "the scheduled restore uses a backup in the old folder"

#: routes_admin.py:436
msgid "базата не можа да бъде проверена"
msgstr "the database could not be checked"

#: routes_admin.py:437
msgid "конфигурационният файл е повреден"
msgstr "the configuration file is damaged"

#: routes_admin.py:438
msgid "в новата папка вече има файлове със същите имена"
msgstr "the new folder already contains files with the same names"

#: routes_admin.py:440
msgid "базата се ползва и от други компютри"
msgstr "the database is also used by other computers"

#: routes_admin.py:462
#, python-format
msgid ""
"PH Logistics: данните са преместени от %(old)s в %(new)s с новите имена "
"на файловете. Нищо не е изтрито."
msgstr ""
"PH Logistics: the data was moved from %(old)s to %(new)s with the new "
"file names. Nothing was deleted."

#: routes_admin.py:466
#, python-format
msgid ""
"PH Logistics: %(reason)s — данните остават в %(folder)s и програмата сочи"
" към тях."
msgstr ""
"PH Logistics: %(reason)s — the data stays in %(folder)s and the program "
"points to it."

#: routes_admin.py:470
#, python-format
msgid ""
"PH Logistics: файловете с данни в %(folder)s са преименувани на новите "
"имена (ph_…). Нищо не е изтрито."
msgstr ""
"PH Logistics: the data files in %(folder)s were renamed to the new names "
"(ph_…). Nothing was deleted."

#: routes_admin.py:473
#, python-format
msgid ""
"PH Logistics: файловете с данни в %(folder)s запазват старите си имена "
"(%(reason)s) — програмата работи с тях нормално."
msgstr ""
"PH Logistics: the data files in %(folder)s keep their old names "
"(%(reason)s) — the program works with them normally."

#: routes_admin.py:478
#, python-format
msgid ""
"PH Logistics: и старата папка %(old)s съдържа данни — те не са пипани. "
"Програмата работи с данните в %(new)s."
msgstr ""
"PH Logistics: the old folder %(old)s also contains data — it was left "
"untouched. The program uses the data in %(new)s."

#: routes_admin.py:482
#, python-format
msgid ""
"PH Logistics: преместването на данните не завърши (%(error)s). Нищо не е "
"изтрито — данните са в %(old)s и %(new)s."
msgstr ""
"PH Logistics: moving the data did not finish (%(error)s). Nothing was "
"deleted — the data is in %(old)s and %(new)s."

#: routes_admin.py:495
msgid ""
"Отбележете, че всички компютри са обновени до 3.80 или по-нова — иначе "
"базата не се преименува."
msgstr ""
"Confirm that all computers are updated to 3.80 or newer — otherwise the "
"database is not renamed."

#: routes_admin.py:507
#, python-format
msgid "Споделената база НЕ е преименувана: %s"
msgstr "The shared database was NOT renamed: %s"

#: routes_admin.py:510
#, python-format
